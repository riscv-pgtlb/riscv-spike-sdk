[submodule "riscv-gnu-toolchain"]
	path = repo/riscv-gnu-toolchain
	url = https://github.com/riscv/riscv-gnu-toolchain.git
[submodule "buildroot"]
	path = repo/buildroot
	url = https://github.com/buildroot/buildroot.git
[submodule "linux"]
	path = repo/linux
	url = https://github.com/riscv-pgtlb/linux.git
	branch = pmp-virt-b1
[submodule "riscv-pk"]
	path = repo/riscv-pk
	url = https://github.com/riscv/riscv-pk
[submodule "riscv-isa-sim"]
	path = repo/riscv-isa-sim
	url = https://github.com/riscv/riscv-isa-sim
[submodule "opensbi"]
	path = repo/opensbi
	url = https://github.com/riscv-pgtlb/opensbi.git
	branch = pmp-virt-b1
[submodule "repo/riscv-openocd"]
	path = repo/riscv-openocd
	url = https://github.com/riscv-collab/riscv-openocd.git
[submodule "repo/kvmtool"]
	path = repo/kvmtool
	url = https://github.com/kvmtool/kvmtool.git
[submodule "repo/dtc"]
	path = repo/dtc
	url = https://git.kernel.org/pub/scm/utils/dtc/dtc.git
[submodule "repo/qemu"]
	path = repo/qemu
	url = https://github.com/riscv-pgtlb/qemu.git
	branch = pmp-virt-b1
